@using WebMatrix.Data

@{
    ViewBag.Title = "Add a New Board Game";
    var db = Database.Open("BoardGame");

    // Load existing families, categories, and themes
    var categories = db.Query("SELECT * FROM GameCategory");
    var families = db.Query("SELECT * FROM GameFamily");
    var themes = db.Query("SELECT * FROM Theme");
}

<main class="container">
    <section class="row">
        <div class="col-12">
            <h3 class="my-4">Add a New Board Game</h3>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <form method="post" action="/Home/Create">
                <div class="mb-3">
                    <label for="gameName" class="form-label">Game Name</label>
                    <input type="text" class="form-control" id="gameName" name="gameName" required>
                </div>

                <div class="mb-3">
                    <label for="gameDescription" class="form-label">Game Description</label>
                    <textarea class="form-control" id="gameDescription" name="gameDescription" rows="3" required></textarea>
                </div>

                <div class="mb-3">
                    <label for="yearPublished" class="form-label">Year Published</label>
                    <input type="number" class="form-control" id="yearPublished" name="yearPublished" min="1900" max="2099" required>
                </div>

                <div class="mb-3">
                    <label for="minPlayers" class="form-label">Minimum Players</label>
                    <input type="number" class="form-control" id="minPlayers" name="minPlayers" min="1" required>
                </div>

                <div class="mb-3">
                    <label for="maxPlayers" class="form-label">Maximum Players</label>
                    <input type="number" class="form-control" id="maxPlayers" name="maxPlayers" min="1" required>
                </div>

                <div class="mb-3">
                    <label for="gameFamily" class="form-label">Game Family</label>
                    <select class="form-select" id="gameFamily" name="gameFamily" required>
                        <option value="">Select a Family</option>
                        @foreach (var family in families)
                        {
                            <option value="@family.Family">@family.Family</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="gameCategory" class="form-label">Game Category</label>
                    <select class="form-select" id="gameCategory" name="gameCategory" required>
                        <option value="">Select a Category</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Category">@category.Category</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="gameTheme" class="form-label">Game Theme</label>
                    <select class="form-select" id="gameTheme" name="gameTheme">
                        <option value="">Select an Existing Theme</option>
                        @foreach (var theme in themes)
                        {
                            <option value="@theme.ThemeID">@theme.ThemeName</option>
                        }
                    </select>
                    <small class="form-text text-muted">Or type a new theme below:</small>
                    <input type="text" class="form-control mt-1" id="newTheme" name="newTheme" placeholder="Enter new theme if not listed">
                </div>

                <button type="submit" class="btn btn-primary">Add Game</button>
            </form>
        </div>
    </section>
</main>

<style>
    .container { max-width: 800px; }
    .form-label { font-weight: bold; }
    .form-text { font-style: italic; }
    .btn-primary { background-color: #5cb85c; border: none; }
    .btn-primary:hover { background-color: #4cae4c; }
    .alert { margin-top: 20px; }
    .form-select, .form-control { border-radius: 0.375rem; box-shadow: 0 0 5px rgba(0,0,0,0.1); }
    .form-control:focus, .form-select:focus { box-shadow: 0 0 5px rgba(96, 165, 255, 0.5); border-color: #60a5fa; }
</style>

<script>
    document.querySelector('form').addEventListener('submit', function(e) {
        var gameName = document.getElementById('gameName').value;
        var gameDescription = document.getElementById('gameDescription').value;
        if (!gameName || !gameDescription) {
            e.preventDefault();
            alert("Please fill in all required fields.");
        }
    });
</script>
